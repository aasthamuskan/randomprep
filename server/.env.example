# RandomPrep — Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# ── Groq AI API Key ───────────────────────────────────────────────────────────
# Get from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Server Config ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB (Optional) ────────────────────────────────────────────────────────
# Only needed if you want MongoDB support
# Leave empty to use local JSON file store only
MONGODB_URI=